{
  "name": "glimpse",
  "productName": "Glimpse",
  "version": "0.1.0",
  "description": "Google AI answers in a quick floating window, with follow-up questions.",
  "license": "MIT",
  "author": {
    "name": "Glimpse contributors",
    "email": "glimpse@users.noreply.github.com"
  },
  "main": "out/main/main.js",
  "scripts": {
    "build": "tsc -b && node -e \"for (const f of ['index.html', 'style.css']) require('node:fs').cpSync('src/ui/' + f, 'out/ui/' + f)\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "app.glimpse.desktop",
    "productName": "Glimpse",
    "files": [
      "out/**/*.js",
      "out/ui/index.html",
      "out/ui/style.css",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Glimpse contributors <glimpse@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github"
    }
  }
}
