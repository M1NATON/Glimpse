{
  "name": "glimpse",
  "productName": "Glimpse",
  "version": "0.3.0",
  "description": "Google AI answers in a quick floating window, with follow-up questions.",
  "license": "MIT",
  "author": {
    "name": "Glimpse contributors",
    "email": "glimpse@users.noreply.github.com"
  },
  "main": "out/main/main.js",
  "scripts": {
    "build": "tsc -b && node scripts/assets.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "geist": "1.7.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "app.glimpse.desktop",
    "productName": "Glimpse",
    "files": [
      "out/**/*.js",
      "out/ui/index.html",
      "out/ui/style.css",
      "out/ui/fonts/*",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/tray.png",
      "build/tray@2x.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
